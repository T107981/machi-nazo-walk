# このファイルをコピーして .env.local を作り、値を入れてください（.env.local はGitHubに上げません）
#   cp .env.example .env.local
#
# 注意: VITE_ で始まる値はブラウザに公開されます。
#       Supabaseは「公開用キー（anon / publishable）」だけを入れ、service_role キーは絶対に入れないでください。

# Supabase: Project Settings の API 画面にある Project URL
VITE_SUPABASE_URL=

# Supabase: 同じ画面にある公開用キー（anon key または publishable key）
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4: 測定ID（G-XXXXXXXXXX の形式）。空のままなら計測しません
VITE_GA_MEASUREMENT_ID=
